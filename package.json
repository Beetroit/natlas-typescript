{
  "name": "@natlas/sdk",
  "version": "0.1.0",
  "description": "Zero-dependency TypeScript/JavaScript SDK for N-ATLAS (Nigeria's multilingual LLM & ASR)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "vitest run"
  },
  "keywords": [
    "natlas",
    "llm",
    "nigeria",
    "yoruba",
    "hausa",
    "igbo",
    "whisper",
    "ai"
  ],
  "author": "N-ATLAS Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.2.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
